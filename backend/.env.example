PORT=5000
CLIENT_ORIGINS=http://localhost:5173

# Option 1: Absolute/relative path to service account JSON file.
# Example: ./service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=<path_to_service_account_json>

# Option 2: Full service account JSON string or base64 encoded JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=<full_json_or_base64>

# Option 3: Individual service account fields.
FIREBASE_PROJECT_ID=<firebase_project_id>
FIREBASE_CLIENT_EMAIL=<firebase_client_email>
FIREBASE_PRIVATE_KEY=<firebase_private_key_with_escaped_newlines>

# Required for Firebase Storage upload support.
FIREBASE_STORAGE_BUCKET=<project_id>.firebasestorage.app
